{
  "name": "agencyhq-build",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/JimmyBlueinc/candidate-compliance.git",
    "buildspec": "buildspec.yml"
  },
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/standard:7.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": true,
    "environmentVariables": [
      {
        "name": "AWS_DEFAULT_REGION",
        "value": "us-east-1"
      }
    ]
  },
  "serviceRole": "arn:aws:iam::788184849448:role/codebuild-agencyhq-service-role",
  "timeoutInMinutes": 30,
  "encryptionKey": "arn:aws:kms:us-east-1:788184849448:alias/aws/s3"
}
