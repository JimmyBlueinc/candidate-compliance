        "@vitejs/plugin-react": "^5.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vueuse/core": "^14.2.1",
        "@vueuse/motion": "^3.0.3",
        "axios": "^1.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.577.0",
        "pinia": "^3.0.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.0",
